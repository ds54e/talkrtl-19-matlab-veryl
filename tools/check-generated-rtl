#!/usr/bin/env bash
# Verify that the committed generated RTL snapshots under rtl/generated/ still
# match a fresh regeneration from the committed sources of truth.
#
#   csr/rggen.yml + csr/ldo_csr.yml          -> rtl/generated/rggen/ldo_csr.sv
#   rtl/veryl/*.veryl + Veryl.toml/Veryl.lock -> rtl/generated/veryl/pgood_supervisor.sv
#
# The snapshots are committed so the generated RTL can be read directly on
# GitHub; they are not a source of truth and must not be hand-edited. This
# script is the cheap way to notice that one of them has drifted from its
# source.
#
# Check mode only: nothing under rtl/generated/ is written. Regeneration goes to
# a temporary directory that is removed on exit. To update a snapshot, check out
# the result and copy the fresh file over it by hand:
#
#   veryl build && cp results/generated/veryl/pgood_supervisor.sv rtl/generated/veryl/
#   bash tools/gen-csr && cp results/generated/csr/ldo_csr.sv rtl/generated/rggen/
#   (cd "$(git rev-parse --show-toplevel)" && sha256sum -c rtl/generated/SHA256SUMS)
#
# Uses only the local toolchain (rggen, veryl). No system install, no network,
# no CI. Generated Veryl file lists (/*.f) are deliberately out of scope: they
# embed checkout-dependent absolute paths.
#
# exit 0 PASS, 1 drift/mismatch, 2 blocked (toolchain missing)

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERYL_BIN="${VERYL_BIN:-veryl}"
RGGEN_BIN="${RGGEN_BIN:-rggen}"

# committed snapshot | path of the fresh counterpart, relative to the work dir.
# `veryl build --out-dir` mirrors the target path from Veryl.toml under the given
# directory, so the fresh supervisor lands in veryl/results/generated/veryl/.
SNAPSHOTS=(
  "rtl/generated/rggen/ldo_csr.sv|csr/ldo_csr.sv"
  "rtl/generated/veryl/pgood_supervisor.sv|veryl/results/generated/veryl/pgood_supervisor.sv"
)
SUMS="rtl/generated/SHA256SUMS"

# veryl and rggen are user-local installs that a non-login shell does not see;
# re-exec once through a login shell rather than requiring the caller to do it.
if [[ "${GENERATED_RTL_CHECK_LOGIN:-0}" != "1" ]] \
   && { ! command -v "$VERYL_BIN" >/dev/null 2>&1 || ! command -v "$RGGEN_BIN" >/dev/null 2>&1; }; then
  exec env GENERATED_RTL_CHECK_LOGIN=1 bash -lc 'exec "$0" "$@"' "$0" "$@"
fi

FAIL=0
note() { printf '%s\n' "$*"; }
fail() { printf 'GENERATED_RTL_CHECK_FAIL: %s\n' "$*" >&2; FAIL=1; }

for tool in "$VERYL_BIN" "$RGGEN_BIN" sha256sum cmp; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "GENERATED_RTL_CHECK_BLOCKED: '$tool' not on PATH" >&2
    echo "(veryl / rggen are user-local installs; run this from a login shell)" >&2
    exit 2
  }
done

WORK="$(mktemp -d "${TMPDIR:-/tmp}/check-generated-rtl.XXXXXX")" || exit 2
trap 'rm -rf "$WORK"' EXIT

cd "$ROOT" || exit 2

note "=== toolchain (measured) ==="
note "veryl: $("$VERYL_BIN" --version 2>&1 | head -1)"
note "rggen: $("$RGGEN_BIN" --version 2>&1 | head -1) / $(ruby --version 2>&1 | head -1)"

# --- regenerate Veryl ---------------------------------------------------------
note
note "=== Veryl: fmt --check, check, build ==="
if ! "$VERYL_BIN" fmt --check; then fail "veryl fmt --check"; fi
if ! "$VERYL_BIN" check; then fail "veryl check"; fi
if ! "$VERYL_BIN" build --out-dir "$WORK/veryl"; then fail "veryl build"; fi

# --- regenerate RgGen CSR -----------------------------------------------------
note
note "=== RgGen: csr/rggen.yml + csr/ldo_csr.yml ==="
if ! CSR_OUT="$WORK/csr" RGGEN_BIN="$RGGEN_BIN" bash tools/gen-csr; then fail "rggen CSR generation"; fi

# --- compare ------------------------------------------------------------------
note
note "=== snapshot comparison ==="
for entry in "${SNAPSHOTS[@]}"; do
  snap="${entry%%|*}"
  fresh="$WORK/${entry##*|}"
  if [[ ! -f "$snap" ]]; then
    fail "missing committed snapshot: $snap"
    continue
  fi
  if [[ ! -f "$fresh" ]]; then
    fail "fresh output missing: $fresh"
    continue
  fi
  if cmp -s "$snap" "$fresh"; then
    note "OK       $snap"
  else
    fail "$snap differs from fresh output"
    diff -u "$snap" "$fresh" | head -n 60 >&2 || true
  fi
done

# --- manifest -----------------------------------------------------------------
note
note "=== $SUMS ==="
if [[ ! -f "$SUMS" ]]; then
  fail "missing manifest: $SUMS"
elif sha256sum -c "$SUMS"; then
  note "OK       $SUMS"
else
  fail "sha256sum -c $SUMS"
fi

note
if [[ "$FAIL" -eq 0 ]]; then
  echo "GENERATED_RTL_CHECK_PASS"
  exit 0
fi
echo "GENERATED_RTL_CHECK_FAILED"
exit 1
