#!/usr/bin/env bash
# Regenerate the CSR SystemVerilog from the committed source of truth.
#
# Source of truth: csr/rggen.yml (configuration) + csr/ldo_csr.yml (register map).
# Generated output is a build artifact: results/generated/csr/ (gitignored).
#
# Requires Ruby 3.4 + rggen on PATH. Override the binary with RGGEN_BIN.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RGGEN_BIN="${RGGEN_BIN:-rggen}"
OUT="${CSR_OUT:-$ROOT/results/generated/csr}"

command -v "$RGGEN_BIN" >/dev/null 2>&1 || {
  echo "CSR_BLOCKED: '$RGGEN_BIN' not on PATH (set RGGEN_BIN to override)" >&2
  exit 2
}

rm -rf "$OUT"
mkdir -p "$OUT"

# `--enable sv_rtl` restricts generation to the RTL writer. The RAL writer
# (sv_ral) exists in the installed gem but is deliberately not enabled: there is
# no use for a UVM RAL model and generating it would add unused artifacts.
"$RGGEN_BIN" -c "$ROOT/csr/rggen.yml" -o "$OUT" --enable sv_rtl "$ROOT/csr/ldo_csr.yml"

GEN="$OUT/ldo_csr.sv"
[[ -f "$GEN" ]] || { echo "CSR_FAIL: $GEN was not generated" >&2; exit 1; }

echo "CSR_GENERATED $GEN"
sha256sum "$GEN" | sed 's/^/csr_sha256=/'
