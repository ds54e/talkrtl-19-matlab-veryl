module pgood_supervisor (
    clk   : input  clock   ,
    rst   : input  reset   ,
    en    : input  logic   ,
    pg_cmp: input  logic   ,
    pgood : output logic   ,
    state : output logic<2>,
) {
    // Keep debug state encoding stable in generated SystemVerilog.
    enum State: logic<2> {
        OFF = 2'd0,
        WAIT = 2'd1,
        ON = 2'd2,
    }

    // ON on the 21st consecutive High sample of pg_cmp, 2 us after the first.
    const PG_STABLE_CYCLES: logic<5> = 5'd20;

    var state_q : State   ;
    var high_cnt: logic<5>; // High samples seen so far in WAIT

    assign state = state_q;
    assign pgood = state_q == State::ON;

    // Priority: rst, en==0, pg_cmp==0, then counting in WAIT; ON holds otherwise.
    always_ff (clk, rst) {
        if_reset {
            // Stateflow: WAIT/ON -> OFF [rst]
            state_q  = State::OFF;
            high_cnt = 0;
        } else {
            if (!en) {
                // Stateflow: WAIT/ON -> OFF [~en]
                state_q  = State::OFF;
                high_cnt = 0;
            } else if (!pg_cmp) {
                // Stateflow: OFF -> WAIT [en && ~rst], ON -> WAIT [~pg_cmp]
                state_q  = State::WAIT;
                high_cnt = 0;
            } else if (state_q != State::ON) {
                if (high_cnt >= PG_STABLE_CYCLES) {
                    // Stateflow: WAIT -> ON [duration(pg_cmp, sec) >= 1.95e-06]
                    state_q = State::ON;
                } else {
                    state_q  = State::WAIT;
                    high_cnt = high_cnt + 1;
                }
            }
        }
    }
}
